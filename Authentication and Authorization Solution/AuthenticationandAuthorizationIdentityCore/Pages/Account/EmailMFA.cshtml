@page  
@model AuthenticationandAuthorizationIdentityCore.Pages.Account.LoginMFAModel  
@{  
}  
<div class="container">  
    <h3>Please enter the verification code sent to your email </h3>  
    <br />

    <div class="container border" style="padding:20px">  
        <form method="post">  
            <div class="text-danger" asp-validation-summary="All"></div>  
            <div class="mb-3 row">  
                <div class="col-2">  
                    <label asp-for="MFAVerification.VerificationCode"></label>  
                </div>  
                <div class="col-5">  
                    <input type="text" asp-for="MFAVerification.VerificationCode" class="form-control" />  
                    <span class="text-danger" asp-validation-for="MFAVerification.VerificationCode" ></span>  
                </div>  
            </div>  

            <div class="mb-3 row">  
                <div class="col-2">  
                    <input type="checkbox" class="form-check-input" asp-for="MFAVerification.RememberMe" />  
                    <label class="form-check-label" asp-for="MFAVerification.RememberMe"></label>  
                </div>  
                <div class="col-5"></div>  
            </div>  

            <div class="mb-3 row">  
                <div class="col-2">  
                    <input type="submit" class="btn btn-primary" value="Verify" />  
                </div>  
            </div>  

        </form>  
    </div>  
</div>