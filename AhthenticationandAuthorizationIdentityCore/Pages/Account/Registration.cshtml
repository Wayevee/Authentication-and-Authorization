@page
@model AuthenticationandAuthorizationIdentityCore.Pages.Accounts.RegistrationModel
@{
}
<h3>Registartion</h3>
<br/>
<div class="container border" style="padding:20px">
    <form method="post">
        <div class="text-danger" asp-validation-summary="All"></div>
        <div class="mb-3 row">
            <div class="col-2">
                <label asp-for="Registration.Email"></label>
            </div>
            <div class="col-5">
                <input type="text" asp-for="Registration.Email" class="form-control" />
                <span class="text-danger" asp-validation-for="Registration.Email"></span>
            </div>
        </div>


        <div class="mb-3 row">
            <div class="col-2">
                <label asp-for="Registration.Password"></label>
            </div>
            <div class="col-5">
                <input type="password" asp-for="Registration.Password" class="form-control" />
                <span class="text-danger" asp-validation-for="Registration.Password"></span>
            </div>
        </div>

        <div class="mb-3 row">
            <div class="col-2">
                <label asp-for="Registration.Department"></label>
            </div>
            <div class="col-5">
                <input type="text" asp-for="Registration.Department" class="form-control" />
                <span class="text-danger" asp-validation-for="Registration.Department"></span>
            </div>
        </div>


        <div class="mb-3 row">
            <div class="col-2">
                <label asp-for="Registration.Position"></label>
            </div>
            <div class="col-5">
                <input type="text" asp-for="Registration.Position" class="form-control" />
                <span class="text-danger" asp-validation-for="Registration.Position"></span>
            </div>
        </div>
        <div class="mb-3 row">
            <div class="col-2">
                <input type="submit" class="btn btn-primary" value="Register" />
            </div>
            <div class="col-5"></div>
        </div>

    </form>
</div>